# Copy to .env and change the values. .env is never committed.
# انسخه إلى .env وغيّر القيم. ملف .env ما ينرفع أبدًا.

# At least 32 random characters. Generate one with: openssl rand -base64 48
# 32 حرف عشوائي على الأقل. ولّد واحد بـ: openssl rand -base64 48
JWT_SECRET=

DB_USERNAME=jobly
DB_PASSWORD=jobly

# Demo accounts are created on an empty database. Set SEED_DEMO_DATA=false in production.
# الحسابات التجريبية تنشأ على قاعدة فاضية. خلّ SEED_DEMO_DATA=false في الإنتاج.
SEED_DEMO_DATA=true
ADMIN_PASSWORD=Admin@12345
CANDIDATE_PASSWORD=Candidate@12345
EMPLOYER_PASSWORD=Employer@12345

# The address people open the app at; email links are built from it.
# العنوان اللي يفتح فيه الناس التطبيق؛ وتُبنى منه روابط الإيميلات.
PUBLIC_URL=http://localhost:8084
CORS_ORIGINS=http://localhost:8084

# Email. The defaults send to the Mailpit container (http://localhost:8025). For a real provider set host, port,
# credentials and MAIL_AUTH=true / MAIL_STARTTLS=true.
# الإيميل. الافتراضي يرسل لحاوية Mailpit. لمزوّد حقيقي حط العنوان والمنفذ والحساب مع MAIL_AUTH وMAIL_STARTTLS.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=Jobly <no-reply@jobly.example>
